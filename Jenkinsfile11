pipeline {
  agent any

  stages {
    stage('Build') {
      agent {
        docker {
          image 'python:3.9-slim'
          args '-e HOME=/tmp'
        }
      }
      steps {
        sh 'pip install --user django==3.2'
        sh 'python manage.py check'
        echo 'Django check completed. Proceeding to next stage...'
      }
    }

    stage('Deploy') {
      when {
        expression { return env.GIT_BRANCH == 'origin/develop' || env.BRANCH_NAME == 'develop' }
      }
      steps {
        // Build the image
        sh 'docker build -t todo .'

        // Run two containers from the same image
        sh 'docker run -d -p 8000:8000 --name todo_container1 todo'
        sh 'docker run -d -p 8001:8000 --name todo_container2 todo'

        // Verify both containers are running
        sh '''
          docker ps --filter "name=todo_container1" --filter "status=running" --format "{{.Names}}" | grep -w todo_container1
          docker ps --filter "name=todo_container2" --filter "status=running" --format "{{.Names}}" | grep -w todo_container2
          echo "Both containers are running"
          docker ps
        '''
      }
      post {
        always {
          echo 'Waiting for 2 minutes before stopping and deleting containers...'
          sleep 120

          echo 'Stopping containers...'
          sh 'docker stop todo_container1 todo_container2 || true'

          echo 'Removing containers...'
          sh 'docker rm todo_container1 todo_container2 || true'
        }
      }
    }
  }

  post {
    success {
      echo 'Pipeline executed successfully'
    }
    failure {
      echo 'Pipeline execution failed'
    }
    always {
      echo 'Pipeline execution completed'
    }
  }
}
